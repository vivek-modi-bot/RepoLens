# Application
APP_NAME=RepoLens
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# JWT (REQUIRED: change in production)
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./repolens.db

# LLM / Ollama
LLM_PROVIDER=ollama
# Local uvicorn: http://localhost:11434  |  Docker Compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1

# Repository processing limits
MAX_FILE_SIZE=100000
MAX_FILES=20
MAX_REPOSITORY_SIZE=50000000
MAX_CHUNK_CHARS=3500
MAX_CHUNKS=8
TEMP_DIR=/tmp/repolens

# GitHub
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30
CLONE_TIMEOUT_SECONDS=120
# Optional for public reviews. To raise PRs, users save a GitHub PAT
# (repo scope) on their Profile page. Tokens are Fernet-encrypted using
# a key derived from JWT_SECRET_KEY and never returned by the API.
